@model Proyecto_N2.Models.Equipo
@{ ViewBag.Title = "Editar registro"; }
<link rel="stylesheet" href="~/Content/Crud.css" />
<div class="form-card"><h2>Editar registro</h2>@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.ValidationSummary(true) <input type="hidden" name="EquipoID" value="@Model.EquipoID" /><div><label>Tipo de equipo</label><input type="text" name="TipoEquipo" value="@Model.TipoEquipo" required />@Html.ValidationMessageFor(m => m.TipoEquipo)</div><div><label>Modelo</label><input type="text" name="Modelo" value="@Model.Modelo" required />@Html.ValidationMessageFor(m => m.Modelo)</div><div><label>Usuario</label><select name="UsuarioID" required><option value="">Seleccione un usuario</option>@foreach (var usuario in ViewBag.Usuarios as IEnumerable<Proyecto_N2.Models.Usuario>) {<option value="@usuario.UsuarioID" @(usuario.UsuarioID == Model.UsuarioID ? "selected" : "")>@usuario.Nombre (@usuario.CorreoElectronico)</option>}</select>@Html.ValidationMessageFor(m => m.UsuarioID)</div><p><button class="btn btn-add" type="submit">Guardar</button> <a class="btn btn-edit" href="@Url.Action("Index")">Cancelar</a></p> }</div>