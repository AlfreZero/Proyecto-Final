@model IEnumerable<Proyecto_N2.Models.Asignacion>
@{ ViewBag.Title = "Mantenimiento de Asignaciones"; }
<link rel="stylesheet" href="~/Content/Crud.css" />
<div class="crud-container"><div class="header-bar"><h2>Mantenimiento de Asignaciones</h2><a class="btn btn-add" href="@Url.Action("Crear")">+ Nuevo registro</a></div>
<table class="crud-table"><thead><tr><th>ID</th><th>Reparación</th><th>Técnico</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.AsignacionID</td><td>@item.ReparacionID</td><td>@item.NombreTecnico</td><td>@item.FechaAsignacion</td><td>@item.EstadoReparacion</td><td><a class="btn btn-edit" href="@Url.Action("Editar", new { id=item.AsignacionID })">Editar</a><form method="post" action="@Url.Action("Eliminar")" style="display:inline" onsubmit="return confirm('¿Eliminar este registro?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.AsignacionID" /><button class="btn btn-delete" type="submit">Eliminar</button></form></td></tr>}</tbody></table></div>