@model Proyecto_N2.Models.Asignacion
@{ ViewBag.Title = "Crear registro"; }
<link rel="stylesheet" href="~/Content/Crud.css" />
<div class="form-card"><h2>Crear registro</h2>@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.ValidationSummary(true) <div><label>Reparación</label><select name="ReparacionID" required><option value="">Seleccione una reparación</option>@foreach (var reparacion in ViewBag.Reparaciones as IEnumerable<Proyecto_N2.Models.Reparacion>) {<option value="@reparacion.ReparacionID" @(reparacion.ReparacionID == Model.ReparacionID ? "selected" : "")>Reparación #@reparacion.ReparacionID - @reparacion.Estado</option>}</select>@Html.ValidationMessageFor(m => m.ReparacionID)</div><div><label>Técnico</label><select name="TecnicoID" required><option value="">Seleccione un técnico</option>@foreach (var tecnico in ViewBag.Tecnicos as IEnumerable<Proyecto_N2.Models.Tecnico>) {<option value="@tecnico.TecnicoID" @(tecnico.TecnicoID == Model.TecnicoID ? "selected" : "")>@tecnico.Nombre - @tecnico.Especialidad</option>}</select>@Html.ValidationMessageFor(m => m.TecnicoID)</div><div><label>Fecha de asignación</label><input type="date" name="FechaAsignacion" value="@(Model.FechaAsignacion.ToString("yyyy-MM-dd"))" required />@Html.ValidationMessageFor(m => m.FechaAsignacion)</div><p><button class="btn btn-add" type="submit">Guardar</button> <a class="btn btn-edit" href="@Url.Action("Index")">Cancelar</a></p> }</div>