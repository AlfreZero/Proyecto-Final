@model Proyecto_N2.Models.Reparacion
@{ ViewBag.Title = "Crear registro"; }
<link rel="stylesheet" href="~/Content/Crud.css" />
<div class="form-card"><h2>Crear registro</h2>@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.ValidationSummary(true) <div><label>Equipo</label><select name="EquipoID" required><option value="">Seleccione un equipo</option>@foreach (var equipo in ViewBag.Equipos as IEnumerable<Proyecto_N2.Models.Equipo>) {<option value="@equipo.EquipoID" @(equipo.EquipoID == Model.EquipoID ? "selected" : "")>@equipo.TipoEquipo - @equipo.Modelo</option>}</select>@Html.ValidationMessageFor(m => m.EquipoID)</div><div><label>Fecha de solicitud</label><input type="date" name="FechaSolicitud" value="@(Model.FechaSolicitud.ToString("yyyy-MM-dd"))" required />@Html.ValidationMessageFor(m => m.FechaSolicitud)</div><div><label>Estado</label><input type="text" name="Estado" value="@Model.Estado" required />@Html.ValidationMessageFor(m => m.Estado)</div><p><button class="btn btn-add" type="submit">Guardar</button> <a class="btn btn-edit" href="@Url.Action("Index")">Cancelar</a></p> }</div>