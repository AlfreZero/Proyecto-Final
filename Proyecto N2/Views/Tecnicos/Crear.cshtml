@model Proyecto_N2.Models.Tecnico
@{ ViewBag.Title = "Crear registro"; }
<link rel="stylesheet" href="~/Content/Crud.css" />
<div class="form-card"><h2>Crear registro</h2>@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.ValidationSummary(true) <div><label>Nombre</label><input type="text" name="Nombre" value="@Model.Nombre" required />@Html.ValidationMessageFor(m => m.Nombre)</div><div><label>Especialidad</label><input type="text" name="Especialidad" value="@Model.Especialidad" required />@Html.ValidationMessageFor(m => m.Especialidad)</div><p><button class="btn btn-add" type="submit">Guardar</button> <a class="btn btn-edit" href="@Url.Action("Index")">Cancelar</a></p> }</div>