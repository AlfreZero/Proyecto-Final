@model IEnumerable<Proyecto_N2.Models.Tecnico>
@{ ViewBag.Title = "Mantenimiento de Técnicos"; }
<link rel="stylesheet" href="~/Content/Crud.css" />
<div class="crud-container"><div class="header-bar"><h2>Mantenimiento de Técnicos</h2><a class="btn btn-add" href="@Url.Action("Crear")">+ Nuevo registro</a></div>
<table class="crud-table"><thead><tr><th>ID</th><th>Nombre</th><th>Especialidad</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.TecnicoID</td><td>@item.Nombre</td><td>@item.Especialidad</td><td><a class="btn btn-edit" href="@Url.Action("Editar", new { id=item.TecnicoID })">Editar</a><form method="post" action="@Url.Action("Eliminar")" style="display:inline" onsubmit="return confirm('¿Eliminar este registro?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.TecnicoID" /><button class="btn btn-delete" type="submit">Eliminar</button></form></td></tr>}</tbody></table></div>