@model Proyecto_N2.Models.DetalleReparacion
@{ ViewBag.Title = "Editar registro"; }
<link rel="stylesheet" href="~/Content/Crud.css" />
<div class="form-card"><h2>Editar registro</h2>@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.ValidationSummary(true) <input type="hidden" name="DetalleID" value="@Model.DetalleID" /><div><label>Reparación</label><select name="ReparacionID" required><option value="">Seleccione una reparación</option>@foreach (var reparacion in ViewBag.Reparaciones as IEnumerable<Proyecto_N2.Models.Reparacion>) {<option value="@reparacion.ReparacionID" @(reparacion.ReparacionID == Model.ReparacionID ? "selected" : "")>Reparación #@reparacion.ReparacionID - @reparacion.Estado</option>}</select>@Html.ValidationMessageFor(m => m.ReparacionID)</div><div><label>Descripción</label><textarea name="Descripcion" rows="4">@Model.Descripcion</textarea>@Html.ValidationMessageFor(m => m.Descripcion)</div><div><label>Fecha de inicio</label><input type="date" name="FechaInicio" value="@(Model.FechaInicio.ToString("yyyy-MM-dd"))" required />@Html.ValidationMessageFor(m => m.FechaInicio)</div><div><label>Fecha de fin</label><input type="date" name="FechaFin" value="@(Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : "")" />@Html.ValidationMessageFor(m => m.FechaFin)</div><p><button class="btn btn-add" type="submit">Guardar</button> <a class="btn btn-edit" href="@Url.Action("Index")">Cancelar</a></p> }</div>