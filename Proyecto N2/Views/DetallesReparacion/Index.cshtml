@model IEnumerable<Proyecto_N2.Models.DetalleReparacion>
@{ ViewBag.Title = "Mantenimiento de Detalles de Reparación"; }
<link rel="stylesheet" href="~/Content/Crud.css" />
<div class="crud-container"><div class="header-bar"><h2>Mantenimiento de Detalles de Reparación</h2><a class="btn btn-add" href="@Url.Action("Crear")">+ Nuevo registro</a></div>
<table class="crud-table"><thead><tr><th>ID</th><th>Reparación</th><th>Descripción</th><th>Inicio</th><th>Fin</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.DetalleID</td><td>@item.ReparacionID</td><td>@item.Descripcion</td><td>@item.FechaInicio</td><td>@item.FechaFin</td><td><a class="btn btn-edit" href="@Url.Action("Editar", new { id=item.DetalleID })">Editar</a><form method="post" action="@Url.Action("Eliminar")" style="display:inline" onsubmit="return confirm('¿Eliminar este registro?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.DetalleID" /><button class="btn btn-delete" type="submit">Eliminar</button></form></td></tr>}</tbody></table></div>